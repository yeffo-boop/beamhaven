// BeamHaven database schema.
// The data model is described in docs/DATA_MODEL.md. Tables are added one
// milestone at a time, starting with logins and households in Milestone 2.
//
// After changing this file, create a migration with:
//   npx prisma migrate dev --name <what_changed>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Logins (Milestone 2). These four tables belong to Better Auth: the field
// names must match what it expects (see docs/DATA_MODEL.md, section 1).
// Tables and columns use snake_case in PostgreSQL; Prisma maps the names.
// ---------------------------------------------------------------------------

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  invitations   Invitation[]
  reminders     Reminder[]

  @@map("users")
}

/// One row per signed-in browser. Deleting a row signs that browser out.
model Session {
  id                String   @id
  token             String   @unique
  expiresAt         DateTime @map("expires_at")
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  /// The household this browser is currently working in.
  activeWorkspaceId String?  @map("active_workspace_id")
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

/// How a user signs in. For email and password, `password` holds the hash
/// (never the password itself).
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens, such as password-reset links.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Households (Milestone 2). Stored as general "workspaces" so a contracting
// company could be one later (ADR-017). Better Auth's organization plugin
// manages these three tables, so their field names follow Better Auth.
// ---------------------------------------------------------------------------

model Workspace {
  id                String           @id
  name              String
  /// Required and unique by Better Auth; not shown or used in addresses.
  slug              String           @unique
  logo              String?
  metadata          String?
  /// "household" for now. A company could be added later (ADR-017).
  kind              String           @default("household")
  /// How measurements are shown and typed by default: "imperial" or "metric".
  measurementSystem String           @default("imperial") @map("measurement_system")
  /// Sales tax added to material estimates, in hundredths of a percent (925 = 9.25%).
  materialsTaxBp    Int              @default(0) @map("materials_tax_bp")
  /// The household\'s IANA time zone ("America/Chicago"): what "today" means
  /// on the calendar, and when reminders go out (Milestone 7).
  timeZone          String           @default("UTC") @map("time_zone")
  createdAt         DateTime         @default(now()) @map("created_at")
  memberships       Membership[]
  invitations       Invitation[]
  properties        Property[]
  budgetCategories  BudgetCategory[]
  vendors           Vendor[]
  contractors       Contractor[]
  priceItems        PriceItem[]
  materials         Material[]
  reminders         Reminder[]
  documents         Document[]

  @@map("workspaces")
}

/// Who belongs to which household, and with which role
/// (owner, member or viewer; a database check allows nothing else).
model Membership {
  id          String    @id
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Invitations to join a household (used from Milestone 2, step 3).
model Invitation {
  id          String    @id
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String?
  status      String
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  inviterId   String    @map("inviter_id")
  inviter     User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Properties, projects and rooms (Milestone 3). docs/DATA_MODEL.md, section 2.
//
// Every table has workspace_id. Child records point at their parent with
// BOTH the parent's id and workspace_id (a composite foreign key), so the
// database itself refuses, for example, a project in household A that
// belongs to a property in household B.
// ---------------------------------------------------------------------------

model Property {
  id           String       @id
  workspaceId  String       @map("workspace_id")
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  addressLine1 String?      @map("address_line1")
  addressLine2 String?      @map("address_line2")
  city         String?
  region       String?
  postalCode   String?      @map("postal_code")
  country      String?
  notes        String?
  createdById  String?      @map("created_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  projects     Project[]
  rooms        Room[]
  attachments  Attachment[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("properties")
}

/// A renovation project. Status values are checked by the database.
model Project {
  id               String              @id
  workspaceId      String              @map("workspace_id")
  propertyId       String              @map("property_id")
  property         Property            @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  name             String
  description      String?
  status           String              @default("planning")
  plannedStart     DateTime?           @map("planned_start") @db.Date
  plannedEnd       DateTime?           @map("planned_end") @db.Date
  actualStart      DateTime?           @map("actual_start") @db.Date
  actualEnd        DateTime?           @map("actual_end") @db.Date
  createdById      String?             @map("created_by_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  rooms            ProjectRoom[]
  attachments      Attachment[]
  /// When the original budget was locked in ("baselined"); null until then.
  budgetLockedAt   DateTime?           @map("budget_locked_at")
  budgetLockedById String?             @map("budget_locked_by_id")
  budgetLines      BudgetLine[]
  contractors      ContractorProject[]
  communications   Communication[]
  warranties       Warranty[]
  tasks            Task[]
  quotes           Quote[]
  contracts        Contract[]
  roomEstimates    RoomEstimate[]
  materials        Material[]
  orders           Order[]
  milestones       Milestone[]
  appointments     Appointment[]
  documents        Document[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([propertyId])
  @@map("projects")
}

/// A room or area of a property. Lengths are whole millimetres; enteredUnit
/// remembers whether the person typed feet and inches or metric.
model Room {
  id              String             @id
  workspaceId     String             @map("workspace_id")
  propertyId      String             @map("property_id")
  property        Property           @relation(fields: [propertyId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  name            String
  type            String             @default("other")
  floorLevel      String?            @map("floor_level")
  lengthMm        Int?               @map("length_mm")
  widthMm         Int?               @map("width_mm")
  ceilingHeightMm Int?               @map("ceiling_height_mm")
  enteredUnit     String             @default("imperial") @map("entered_unit")
  description     String?
  notes           String?
  createdById     String?            @map("created_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  projects        ProjectRoom[]
  openings        Opening[]
  attachments     Attachment[]
  budgetLines     BudgetLine[]
  warranties      Warranty[]
  tasks           Task[]
  estimateAreas   RoomEstimateArea[]
  materials       Material[]
  appointments    Appointment[]
  documents       Document[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([propertyId])
  @@map("rooms")
}

/// Which rooms a project works on. A room can be part of many projects over time.
model ProjectRoom {
  workspaceId         String   @map("workspace_id")
  projectId           String   @map("project_id")
  project             Project  @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  roomId              String   @map("room_id")
  room                Room     @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  plannedImprovements String?  @map("planned_improvements")
  createdAt           DateTime @default(now()) @map("created_at")

  @@id([projectId, roomId])
  @@index([workspaceId])
  @@index([roomId])
  @@map("project_rooms")
}

/// A window, door or other opening in a room, with its size in millimetres.
model Opening {
  id           String   @id
  workspaceId  String   @map("workspace_id")
  roomId       String   @map("room_id")
  room         Room     @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  kind         String
  label        String?
  widthMm      Int      @map("width_mm")
  heightMm     Int      @map("height_mm")
  sillHeightMm Int?     @map("sill_height_mm")
  enteredUnit  String   @default("imperial") @map("entered_unit")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([roomId])
  @@map("openings")
}

// ---------------------------------------------------------------------------
// Files (Milestone 3). The file itself lives in storage under storageKey
// (random, never built from the file name). docs/DATA_MODEL.md, section 5.
// ---------------------------------------------------------------------------

model FileObject {
  id              String           @id
  workspaceId     String           @map("workspace_id")
  storageKey      String           @unique @map("storage_key")
  originalName    String           @map("original_name")
  /// Worked out from the file's contents, never from its name or the browser.
  mimeType        String           @map("mime_type")
  sizeBytes       Int              @map("size_bytes")
  sha256          String
  uploadedById    String?          @map("uploaded_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  attachments     Attachment[]
  documentVersion DocumentVersion?

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("files")
}

/// Links a file to exactly one record (a database check enforces "exactly one").
model Attachment {
  id           String      @id
  workspaceId  String      @map("workspace_id")
  fileId       String      @map("file_id")
  file         FileObject  @relation(fields: [fileId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  purpose      String      @default("photo")
  caption      String?
  propertyId   String?     @map("property_id")
  property     Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  projectId    String?     @map("project_id")
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roomId       String?     @map("room_id")
  room         Room?       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  expenseId    String?     @map("expense_id")
  expense      Expense?    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  contractorId String?     @map("contractor_id")
  contractor   Contractor? @relation(fields: [contractorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  quoteId      String?     @map("quote_id")
  quote        Quote?      @relation(fields: [quoteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  contractId   String?     @map("contract_id")
  contract     Contract?   @relation(fields: [contractId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  warrantyId   String?     @map("warranty_id")
  warranty     Warranty?   @relation(fields: [warrantyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  materialId   String?     @map("material_id")
  material     Material?   @relation(fields: [materialId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  orderId      String?     @map("order_id")
  order        Order?      @relation(fields: [orderId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdById  String?     @map("created_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([fileId])
  @@index([propertyId])
  @@index([projectId])
  @@index([roomId])
  @@index([expenseId])
  @@index([contractorId])
  @@index([warrantyId])
  @@index([quoteId])
  @@index([contractId])
  @@index([materialId])
  @@index([orderId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Activity history (from Milestone 3). Written by the services whenever
// something important changes; never edited or deleted.
// ---------------------------------------------------------------------------

model ActivityEvent {
  id          String   @id
  workspaceId String   @map("workspace_id")
  actorUserId String?  @map("actor_user_id")
  /// For example "project.created" or "room.updated".
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  summary     String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_events")
}

// --- Budget (Milestone 4). What each number means: docs/BUDGET_DEFINITIONS.md.
// All money is whole cents in BIGINT columns (ADR-008).

model BudgetCategory {
  id                String         @id
  workspaceId       String         @map("workspace_id")
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  /// "standard", or "contingency" for the safety buffer.
  kind              String         @default("standard")
  sortOrder         Int            @default(0) @map("sort_order")
  createdAt         DateTime       @default(now()) @map("created_at")
  lines             BudgetLine[]
  materialEstimates RoomEstimate[] @relation("EstimateMaterialCategory")
  laborEstimates    RoomEstimate[] @relation("EstimateLaborCategory")

  @@unique([id, workspaceId])
  @@unique([workspaceId, name])
  @@map("budget_categories")
}

/// One bucket of money: a project, a category and optionally a room.
/// Unique per (project, category, room, name). The migration creates that
/// index with NULLS NOT DISTINCT, so "no room" also counts as one value.
model BudgetLine {
  id               String              @id
  workspaceId      String              @map("workspace_id")
  projectId        String              @map("project_id")
  project          Project             @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  categoryId       String              @map("category_id")
  category         BudgetCategory      @relation(fields: [categoryId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  roomId           String?             @map("room_id")
  room             Room?               @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  /// Optional label to tell apart two lines with the same category and room.
  name             String              @default("")
  /// The plan; can be edited only until the project budget is locked in.
  plannedCents     BigInt              @default(0) @map("planned_cents")
  /// Copied from plannedCents when the budget is locked in; never changes after.
  originalCents    BigInt?             @map("original_cents")
  estimateCents    BigInt?             @map("estimate_cents")
  /// Set when a room estimate (Milestone 5, part 3) keeps this line\'s estimate up to date.
  estimateSourceId String?             @map("estimate_source_id")
  estimateSource   RoomEstimate?       @relation("EstimateLines", fields: [estimateSourceId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  adjustments      BudgetAdjustment[]
  transfersOut     BudgetTransfer[]    @relation("TransferFrom")
  transfersIn      BudgetTransfer[]    @relation("TransferTo")
  commitments      Commitment[]
  quotes           Quote[]
  allocations      ExpenseAllocation[]
  orderItems       OrderItem[]

  @@unique([id, workspaceId])
  @@unique([projectId, categoryId, roomId, name], map: "budget_lines_unique_bucket")
  @@index([estimateSourceId])
  @@index([workspaceId])
  @@index([projectId])
  @@map("budget_lines")
}

/// A deliberate change to the budget total. Kept permanently.
model BudgetAdjustment {
  id            String     @id
  workspaceId   String     @map("workspace_id")
  lineId        String     @map("line_id")
  line          BudgetLine @relation(fields: [lineId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  amountCents   BigInt     @map("amount_cents")
  reason        String
  effectiveDate DateTime   @map("effective_date") @db.Date
  createdById   String?    @map("created_by_id")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([lineId])
  @@map("budget_adjustments")
}

/// Moves money between lines; the total stays the same. Never edited or
/// deleted: undone by a reversing transfer (BUDGET_DEFINITIONS rule 7).
model BudgetTransfer {
  id                  String          @id
  workspaceId         String          @map("workspace_id")
  fromLineId          String          @map("from_line_id")
  fromLine            BudgetLine      @relation("TransferFrom", fields: [fromLineId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  toLineId            String          @map("to_line_id")
  toLine              BudgetLine      @relation("TransferTo", fields: [toLineId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  amountCents         BigInt          @map("amount_cents")
  reason              String
  effectiveDate       DateTime        @map("effective_date") @db.Date
  allowOverAllocation Boolean         @default(false) @map("allow_over_allocation")
  /// Set on a reversing transfer; each transfer can be reversed once.
  reversesTransferId  String?         @map("reverses_transfer_id")
  reverses            BudgetTransfer? @relation("Reversal", fields: [reversesTransferId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  reversedBy          BudgetTransfer? @relation("Reversal")
  createdById         String?         @map("created_by_id")
  createdAt           DateTime        @default(now()) @map("created_at")

  @@unique([id, workspaceId])
  @@unique([reversesTransferId, workspaceId])
  @@index([workspaceId])
  @@index([fromLineId])
  @@index([toLineId])
  @@map("budget_transfers")
}

/// Shops, suppliers and (from Milestone 5) contractors that get paid.
model Vendor {
  id          String       @id
  workspaceId String       @map("workspace_id")
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// "store", "online", "contractor" or "other".
  kind        String       @default("store")
  website     String?
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  commitments Commitment[]
  expenses    Expense[]
  contractor  Contractor?
  materials   Material[]
  orders      Order[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, name])
  @@map("vendors")
}

/// Money we've agreed to spend: an approved quote, a contract, a change
/// order or a placed order.
model Commitment {
  id          String              @id
  workspaceId String              @map("workspace_id")
  lineId      String              @map("line_id")
  line        BudgetLine          @relation(fields: [lineId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  vendorId    String?             @map("vendor_id")
  vendor      Vendor?             @relation(fields: [vendorId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  /// "quote", "contract", "change_order", "order" or "manual".
  source      String              @default("manual")
  description String
  amountCents BigInt              @map("amount_cents")
  committedOn DateTime            @map("committed_on") @db.Date
  notes       String?
  /// Set on a change order: the contract it changes.
  contractId  String?             @map("contract_id")
  contract    Contract?           @relation("ChangeOrders", fields: [contractId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  /// Set on an order's commitment: one per budget line the order is charged to.
  orderId     String?             @map("order_id")
  order       Order?              @relation(fields: [orderId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdById String?             @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  expenses    Expense[]
  quote       Quote?
  contractFor Contract?           @relation("ContractCommitment")
  allocations ExpenseAllocation[]

  @@unique([id, workspaceId])
  @@unique([orderId, lineId])
  @@index([workspaceId])
  @@index([lineId])
  @@index([contractId])
  @@map("commitments")
}

/// A cost that has happened: a bill received or a purchase made. A refund
/// is a negative expense pointing at the original. Whether it's paid is
/// worked out from its payments, never stored.
model Expense {
  id                String              @id
  workspaceId       String              @map("workspace_id")
  vendorId          String?             @map("vendor_id")
  vendor            Vendor?             @relation(fields: [vendorId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  commitmentId      String?             @map("commitment_id")
  commitment        Commitment?         @relation(fields: [commitmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  refundOfExpenseId String?             @map("refund_of_expense_id")
  refundOf          Expense?            @relation("Refund", fields: [refundOfExpenseId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  refunds           Expense[]           @relation("Refund")
  description       String
  expenseDate       DateTime            @map("expense_date") @db.Date
  dueDate           DateTime?           @map("due_date") @db.Date
  totalCents        BigInt              @map("total_cents")
  notes             String?
  /// For a contractor's bill: "deposit", "progress" or "final".
  stage             String?
  createdById       String?             @map("created_by_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  allocations       ExpenseAllocation[]
  payments          Payment[]
  attachments       Attachment[]
  /// Set when this expense is an order's bill.
  billFor           Order?              @relation("OrderBill")
  returnFor         OrderReturn?        @relation("ReturnRefund")

  @@unique([id, workspaceId])
  @@index([workspaceId, expenseDate])
  @@index([commitmentId])
  @@map("expenses")
}

/// Which budget line(s) an expense is charged to. They must add up to the
/// expense total, to the cent (checked by the service and by the database).
model ExpenseAllocation {
  id           String      @id
  workspaceId  String      @map("workspace_id")
  expenseId    String      @map("expense_id")
  expense      Expense     @relation(fields: [expenseId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  lineId       String      @map("line_id")
  line         BudgetLine  @relation(fields: [lineId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  amountCents  BigInt      @map("amount_cents")
  /// "item", "tax" or "shipping".
  kind         String      @default("item")
  /// The row's place on the expense, so splits always show in the order typed.
  position     Int         @default(0)
  /// On an order's bill, each part uses up the order's commitment on its
  /// own line. Other expenses link a commitment on the expense instead.
  commitmentId String?     @map("commitment_id")
  commitment   Commitment? @relation(fields: [commitmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([expenseId])
  @@index([lineId])
  @@index([commitmentId])
  @@map("expense_allocations")
}

/// Money that has left our account (or, for a refund, come back).
model Payment {
  id          String   @id
  workspaceId String   @map("workspace_id")
  expenseId   String   @map("expense_id")
  expense     Expense  @relation(fields: [expenseId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  amountCents BigInt   @map("amount_cents")
  paidOn      DateTime @map("paid_on") @db.Date
  /// "card", "check", "transfer", "cash" or "other".
  method      String   @default("other")
  reference   String?
  notes       String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([expenseId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Contractors (Milestone 5). docs/DATA_MODEL.md, section 4.
//
// A contractor is a Vendor (the "shop or supplier" a budget records money
// against) with more details, so every bill already recorded under that
// name shows up on the contractor's page. The name lives on the vendor.
//
// Optional links between records use Restrict: Postgres would otherwise
// clear workspace_id along with the link. The services clear the link
// themselves when the other record is deleted.
// ---------------------------------------------------------------------------

model Contractor {
  id                 String              @id
  workspaceId        String              @map("workspace_id")
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vendorId           String              @map("vendor_id")
  vendor             Vendor              @relation(fields: [vendorId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  contactName        String?             @map("contact_name")
  trade              String?
  phone              String?
  email              String?
  website            String?
  address            String?
  licenseNumber      String?             @map("license_number")
  licenseState       String?             @map("license_state")
  licenseExpiresOn   DateTime?           @map("license_expires_on") @db.Date
  insuranceProvider  String?             @map("insurance_provider")
  insuranceExpiresOn DateTime?           @map("insurance_expires_on") @db.Date
  /// "prospect", "active", "past" or "do_not_use".
  status             String              @default("active")
  notes              String?
  createdById        String?             @map("created_by_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  projects           ContractorProject[]
  communications     Communication[]
  warranties         Warranty[]
  tasks              Task[]
  attachments        Attachment[]
  quotes             Quote[]
  contracts          Contract[]
  appointments       Appointment[]
  documents          Document[]

  @@unique([id, workspaceId])
  @@unique([vendorId, workspaceId])
  @@index([workspaceId])
  @@map("contractors")
}

/// Which contractors work on which projects, and doing what.
model ContractorProject {
  workspaceId  String     @map("workspace_id")
  contractorId String     @map("contractor_id")
  contractor   Contractor @relation(fields: [contractorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  projectId    String     @map("project_id")
  project      Project    @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  role         String?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([contractorId, projectId])
  @@index([workspaceId])
  @@index([projectId])
  @@map("contractor_projects")
}

/// A call, email, text, meeting or note with a contractor, typed in by hand.
model Communication {
  id           String     @id
  workspaceId  String     @map("workspace_id")
  contractorId String     @map("contractor_id")
  contractor   Contractor @relation(fields: [contractorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  projectId    String?    @map("project_id")
  project      Project?   @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  /// "call", "email", "text", "meeting" or "note".
  channel      String     @default("note")
  occurredOn   DateTime   @map("occurred_on") @db.Date
  summary      String
  createdById  String?    @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([contractorId, occurredOn])
  @@index([projectId])
  @@map("communications")
}

/// A warranty on work or an item. Linked to a contractor, a project or a
/// room (at least one; a database check makes sure).
model Warranty {
  id           String       @id
  workspaceId  String       @map("workspace_id")
  contractorId String?      @map("contractor_id")
  contractor   Contractor?  @relation(fields: [contractorId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  projectId    String?      @map("project_id")
  project      Project?     @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  roomId       String?      @map("room_id")
  room         Room?        @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  materialId   String?      @map("material_id")
  material     Material?    @relation(fields: [materialId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  coverage     String
  /// Who honours it, when that isn't the contractor (a manufacturer, say).
  provider     String?
  startsOn     DateTime?    @map("starts_on") @db.Date
  expiresOn    DateTime?    @map("expires_on") @db.Date
  notes        String?
  createdById  String?      @map("created_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  attachments  Attachment[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([contractorId])
  @@index([projectId])
  @@index([roomId])
  @@index([materialId])
  @@map("warranties")
}

/// A simple to-do on a project or a room (at least one; checked by the
/// database). The full schedule arrives in Milestone 7.
model Task {
  id                   String           @id
  workspaceId          String           @map("workspace_id")
  projectId            String?          @map("project_id")
  project              Project?         @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  roomId               String?          @map("room_id")
  room                 Room?            @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  title                String
  description          String?
  /// "todo", "doing" or "done".
  status               String           @default("todo")
  /// "low", "normal" or "high".
  priority             String           @default("normal")
  /// A household member (checked by the service when assigning).
  assigneeUserId       String?          @map("assignee_user_id")
  assigneeContractorId String?          @map("assignee_contractor_id")
  assigneeContractor   Contractor?      @relation(fields: [assigneeContractorId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  dueDate              DateTime?        @map("due_date") @db.Date
  /// A stage of the task's own project (Milestone 7, ADR-031). The key
  /// includes the project, so the database keeps the two together.
  milestoneId          String?          @map("milestone_id")
  milestone            Milestone?       @relation(fields: [milestoneId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  /// Tasks this one waits on, and tasks waiting on it.
  waitsOn              TaskDependency[] @relation("DependentTask")
  neededFor            TaskDependency[] @relation("PrerequisiteTask")
  completedAt          DateTime?        @map("completed_at")
  createdById          String?          @map("created_by_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([roomId])
  @@index([assigneeContractorId])
  @@index([milestoneId])
  @@map("tasks")
}

/// A stage of a project, like "Demolition" or "Cabinets in" (Milestone 7).
/// It's done when all its tasks are; nothing about that is stored.
model Milestone {
  id          String    @id
  workspaceId String    @map("workspace_id")
  projectId   String    @map("project_id")
  project     Project   @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  name        String
  targetDate  DateTime? @map("target_date") @db.Date
  notes       String?
  position    Int       @default(0)
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tasks       Task[]

  @@unique([id, workspaceId])
  @@unique([id, projectId, workspaceId])
  @@unique([projectId, name])
  @@index([workspaceId])
  @@index([projectId])
  @@map("milestones")
}

/// `taskId` can't start (or be finished) until `dependsOnId` is done.
model TaskDependency {
  workspaceId String   @map("workspace_id")
  taskId      String   @map("task_id")
  task        Task     @relation("DependentTask", fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  dependsOnId String   @map("depends_on_id")
  dependsOn   Task     @relation("PrerequisiteTask", fields: [dependsOnId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([taskId, dependsOnId])
  @@index([workspaceId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

/// A price a contractor has given. Each new price is a revision; the
/// latest is the one that counts. Approving it puts it in the budget as a
/// commitment.
model Quote {
  id           String          @id
  workspaceId  String          @map("workspace_id")
  contractorId String          @map("contractor_id")
  contractor   Contractor      @relation(fields: [contractorId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  projectId    String          @map("project_id")
  project      Project         @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  /// The budget line it was approved onto.
  lineId       String?         @map("line_id")
  line         BudgetLine?     @relation(fields: [lineId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  title        String
  /// "received", "under_review", "approved" or "rejected".
  status       String          @default("received")
  validUntil   DateTime?       @map("valid_until") @db.Date
  notes        String?
  commitmentId String?         @unique @map("commitment_id")
  commitment   Commitment?     @relation(fields: [commitmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  decidedAt    DateTime?       @map("decided_at")
  decidedById  String?         @map("decided_by_id")
  decisionNote String?         @map("decision_note")
  createdById  String?         @map("created_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  revisions    QuoteRevision[]
  /// Optional: a room estimate to compare this quote\'s price with.
  estimateId   String?         @map("estimate_id")
  estimate     RoomEstimate?   @relation(fields: [estimateId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  contract     Contract?
  attachments  Attachment[]

  @@unique([id, workspaceId])
  @@unique([commitmentId, workspaceId])
  @@index([workspaceId])
  @@index([contractorId])
  @@index([projectId])
  @@map("quotes")
}

model QuoteRevision {
  id             String   @id
  workspaceId    String   @map("workspace_id")
  quoteId        String   @map("quote_id")
  quote          Quote    @relation(fields: [quoteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  revisionNumber Int      @map("revision_number")
  amountCents    BigInt   @map("amount_cents")
  receivedOn     DateTime @map("received_on") @db.Date
  summary        String?
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([quoteId, revisionNumber])
  @@index([workspaceId])
  @@map("quote_revisions")
}

/// A signed agreement with a contractor. Its value is its commitment's
/// amount (one place for the number); change orders are commitments that
/// point back at it.
model Contract {
  id           String       @id
  workspaceId  String       @map("workspace_id")
  contractorId String       @map("contractor_id")
  contractor   Contractor   @relation(fields: [contractorId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  projectId    String       @map("project_id")
  project      Project      @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  quoteId      String?      @unique @map("quote_id")
  quote        Quote?       @relation(fields: [quoteId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  commitmentId String       @unique @map("commitment_id")
  commitment   Commitment   @relation("ContractCommitment", fields: [commitmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  title        String
  signedOn     DateTime?    @map("signed_on") @db.Date
  startDate    DateTime?    @map("start_date") @db.Date
  endDate      DateTime?    @map("end_date") @db.Date
  notes        String?
  createdById  String?      @map("created_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  changeOrders Commitment[] @relation("ChangeOrders")
  attachments  Attachment[]

  @@unique([id, workspaceId])
  @@unique([quoteId, workspaceId])
  @@unique([commitmentId, workspaceId])
  @@index([workspaceId])
  @@index([contractorId])
  @@index([projectId])
  @@map("contracts")
}

// ---------------------------------------------------------------------------
// Room-based cost estimates (Milestone 5, part 3). docs/DATA_MODEL.md,
// section 3, and docs/BUDGET_DEFINITIONS.md, "Room estimates".
// ---------------------------------------------------------------------------

/// A price the household reuses: flooring per sq ft, paint per gallon, trim per linear foot.
model PriceItem {
  id           String         @id
  workspaceId  String         @map("workspace_id")
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  /// What it's measured by: floor, walls, ceiling or perimeter.
  measure      String
  /// sq_ft, sq_m, lin_ft, lin_m (priced by size) or gallon, litre (priced by the can).
  unit         String
  priceCents   BigInt         @map("price_cents")
  /// For paint: the area one gallon or litre covers, in square millimetres.
  coverageMm2  Int?           @map("coverage_mm2")
  coats        Int            @default(1)
  /// Optional install price per sq ft, sq m, linear foot or metre (no waste, no tax).
  laborCents   BigInt?        @map("labor_cents")
  wastePercent Int            @default(0) @map("waste_percent")
  taxable      Boolean        @default(true)
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  estimates    RoomEstimate[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, name])
  @@map("price_items")
}

/// One price-list item used in some of a project's rooms, kept in step with the budget.
model RoomEstimate {
  id                 String             @id
  workspaceId        String             @map("workspace_id")
  projectId          String             @map("project_id")
  project            Project            @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  priceItemId        String             @map("price_item_id")
  priceItem          PriceItem          @relation(fields: [priceItemId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  name               String
  materialCategoryId String             @map("material_category_id")
  materialCategory   BudgetCategory     @relation("EstimateMaterialCategory", fields: [materialCategoryId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  laborCategoryId    String?            @map("labor_category_id")
  laborCategory      BudgetCategory?    @relation("EstimateLaborCategory", fields: [laborCategoryId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  /// per_room: a budget line for each room; one_line: one line for the whole project.
  lineMode           String             @default("per_room") @map("line_mode")
  notes              String?
  createdById        String?            @map("created_by_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  areas              RoomEstimateArea[]
  lines              BudgetLine[]       @relation("EstimateLines")
  quotes             Quote[]

  @@unique([id, workspaceId])
  @@unique([projectId, name])
  @@index([workspaceId])
  @@index([priceItemId])
  @@map("room_estimates")
}

/// A room in an estimate (measured from its size), or an area typed by hand.
model RoomEstimateArea {
  id          String       @id
  workspaceId String       @map("workspace_id")
  estimateId  String       @map("estimate_id")
  estimate    RoomEstimate @relation(fields: [estimateId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  roomId      String?      @map("room_id")
  room        Room?        @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  label       String?
  /// Typed by hand: square millimetres (or millimetres for a perimeter). Null: measure the room.
  typedAmount Int?         @map("typed_amount")
  enteredUnit String       @default("imperial") @map("entered_unit")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([estimateId])
  @@index([roomId])
  @@map("room_estimate_areas")
}

// ---------------------------------------------------------------------------
// Materials (Milestone 6). A product being considered or bought: tile, a
// faucet, paint, an appliance. Orders, deliveries and returns follow.
// ---------------------------------------------------------------------------

/// A product for a project or room (either, both or neither). Links are
/// RESTRICT in the database; the services let go of them before a project,
/// room or supplier is deleted (see docs/DATA_MODEL.md).
model Material {
  id              String       @id
  workspaceId     String       @map("workspace_id")
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId       String?      @map("project_id")
  project         Project?     @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  roomId          String?      @map("room_id")
  room            Room?        @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  /// Where it comes from: the store or supplier, shared with expenses.
  supplierId      String?      @map("supplier_id")
  supplier        Vendor?      @relation(fields: [supplierId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  name            String
  /// A free-text kind, like "Tile" or "Faucet", for grouping.
  category        String?
  brand           String?
  modelNumber     String?      @map("model_number")
  sku             String?
  colorFinish     String?      @map("color_finish")
  productUrl      String?      @map("product_url")
  /// How many, in thousandths (2.5 boxes = 2500), so no floats are stored.
  quantityMilli   Int?         @map("quantity_milli")
  /// What one is: "box", "sq ft", "each".
  unit            String?
  /// The expected price for one unit. What was actually paid lives on the order (part 2).
  unitPriceCents  BigInt?      @map("unit_price_cents")
  /// considering, selected, ordered, delivered, installed, returned or canceled.
  status          String       @default("considering")
  statusChangedAt DateTime     @default(now()) @map("status_changed_at")
  specs           String?
  notes           String?
  createdById     String?      @map("created_by_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  attachments     Attachment[]
  warranties      Warranty[]
  orderItems      OrderItem[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([roomId])
  @@index([supplierId])
  @@map("materials")
}

/// An order from a store or supplier, for one project. Its items say what
/// was bought at what price (kept as it was paid) and which budget line
/// pays for it. The order is a commitment on each of those lines until its
/// bill is recorded (ADR-029).
model Order {
  id            String        @id
  workspaceId   String        @map("workspace_id")
  projectId     String        @map("project_id")
  project       Project       @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  supplierId    String        @map("supplier_id")
  supplier      Vendor        @relation(fields: [supplierId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  orderNumber   String?       @map("order_number")
  orderedOn     DateTime      @map("ordered_on") @db.Date
  /// When the store says it should arrive (for the calendar).
  expectedOn    DateTime?     @map("expected_on") @db.Date
  shippingCents BigInt        @default(0) @map("shipping_cents")
  taxCents      BigInt        @default(0) @map("tax_cents")
  notes         String?
  /// The bill or receipt, once recorded. It's an ordinary expense.
  billId        String?       @unique @map("bill_id")
  bill          Expense?      @relation("OrderBill", fields: [billId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdById   String?       @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  items         OrderItem[]
  deliveries    Delivery[]
  returns       OrderReturn[]
  commitments   Commitment[]
  attachments   Attachment[]

  @@unique([id, workspaceId])
  @@unique([billId, workspaceId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([supplierId])
  @@map("orders")
}

/// One thing on an order. The price is what was paid, saved with the order.
model OrderItem {
  id             String         @id
  workspaceId    String         @map("workspace_id")
  orderId        String         @map("order_id")
  order          Order          @relation(fields: [orderId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  materialId     String?        @map("material_id")
  material       Material?      @relation(fields: [materialId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  /// NO ACTION, so a project's delete can remove its lines and orders together.
  lineId         String         @map("line_id")
  line           BudgetLine     @relation(fields: [lineId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  description    String
  quantityMilli  Int            @map("quantity_milli")
  unitPriceCents BigInt         @map("unit_price_cents")
  position       Int            @default(0)
  deliveryItems  DeliveryItem[]
  returnItems    ReturnItem[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([orderId])
  @@index([materialId])
  @@index([lineId])
  @@map("order_items")
}

/// Some or all of an order arriving on one day.
model Delivery {
  id          String         @id
  workspaceId String         @map("workspace_id")
  orderId     String         @map("order_id")
  order       Order          @relation(fields: [orderId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  deliveredOn DateTime       @map("delivered_on") @db.Date
  notes       String?
  createdById String?        @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  items       DeliveryItem[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([orderId])
  @@map("deliveries")
}

model DeliveryItem {
  id            String    @id
  workspaceId   String    @map("workspace_id")
  deliveryId    String    @map("delivery_id")
  delivery      Delivery  @relation(fields: [deliveryId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  orderItemId   String    @map("order_item_id")
  orderItem     OrderItem @relation(fields: [orderItemId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  quantityMilli Int       @map("quantity_milli")

  @@unique([deliveryId, orderItemId])
  @@index([workspaceId])
  @@index([orderItemId])
  @@map("delivery_items")
}

/// Some of an order sent back (Milestone 6, part 3, ADR-030). Only after
/// the bill is recorded; its refund is a negative expense against the bill.
model OrderReturn {
  id          String       @id
  workspaceId String       @map("workspace_id")
  orderId     String       @map("order_id")
  order       Order        @relation(fields: [orderId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  returnedOn  DateTime     @map("returned_on") @db.Date
  /// What the store gave back (0 if nothing). Kept as typed.
  refundCents BigInt       @map("refund_cents")
  /// The refund expense; none when nothing was given back.
  refundId    String?      @unique @map("refund_id")
  refund      Expense?     @relation("ReturnRefund", fields: [refundId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  notes       String?
  createdById String?      @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  items       ReturnItem[]

  @@unique([id, workspaceId])
  @@unique([refundId, workspaceId])
  @@index([workspaceId])
  @@index([orderId])
  @@map("order_returns")
}

model ReturnItem {
  id            String      @id
  workspaceId   String      @map("workspace_id")
  returnId      String      @map("return_id")
  orderReturn   OrderReturn @relation(fields: [returnId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  orderItemId   String      @map("order_item_id")
  orderItem     OrderItem   @relation(fields: [orderItemId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  quantityMilli Int         @map("quantity_milli")

  @@index([workspaceId])
  @@index([returnId])
  @@index([orderItemId])
  @@map("return_items")
}

/// Something on the calendar at a time: a site visit, an inspection, a
/// delivery window (Milestone 7, part 2, ADR-032). The day is a calendar day
/// and the times are wall-clock "HH:MM" in the household's time zone.
model Appointment {
  id           String      @id
  workspaceId  String      @map("workspace_id")
  title        String
  /// "appointment", "inspection", "delivery" or "other".
  kind         String      @default("appointment")
  day          DateTime    @db.Date
  startTime    String?     @map("start_time")
  endTime      String?     @map("end_time")
  location     String?
  projectId    String?     @map("project_id")
  project      Project?    @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  roomId       String?     @map("room_id")
  room         Room?       @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  contractorId String?     @map("contractor_id")
  contractor   Contractor? @relation(fields: [contractorId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  /// An inspection's result: "passed", "failed" or null (not yet).
  outcome      String?
  notes        String?
  createdById  String?     @map("created_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@unique([id, workspaceId])
  @@index([workspaceId, day])
  @@index([projectId])
  @@index([roomId])
  @@index([contractorId])
  @@map("appointments")
}

/// An in-app reminder for one person (Milestone 7, part 3, ADR-033). The
/// worker writes these from the calendar; the title and link are copied so a
/// reminder still reads sensibly if its record changes later.
model Reminder {
  id          String    @id
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The calendar entry it's about, like "task:<id>" or "appointment:<id>".
  entryKey    String    @map("entry_key")
  /// The calendar kind: "task", "inspection", "payment", ...
  kind        String
  title       String
  href        String
  /// The day the thing happens (or is due).
  day         DateTime  @db.Date
  /// When the reminder showed up.
  createdAt   DateTime  @default(now()) @map("created_at")
  readAt      DateTime? @map("read_at")

  /// One reminder per person, thing and day, so running the worker twice is harmless.
  @@unique([userId, entryKey, day])
  @@index([workspaceId, userId, readAt])
  @@map("reminders")
}

// ---------------------------------------------------------------------------
// Document library (Milestone 8, part 1, ADR-034). A document keeps every
// version of its file; the newest is the current one.
// ---------------------------------------------------------------------------

model Document {
  id           String            @id
  workspaceId  String            @map("workspace_id")
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title        String
  /// "plan", "rendering", "permit", "contract", "manual", "warranty",
  /// "inspection", "invoice" or "other".
  category     String            @default("other")
  projectId    String?           @map("project_id")
  project      Project?          @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  roomId       String?           @map("room_id")
  room         Room?             @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  contractorId String?           @map("contractor_id")
  contractor   Contractor?       @relation(fields: [contractorId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  notes        String?
  createdById  String?           @map("created_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  versions     DocumentVersion[]

  @@unique([id, workspaceId])
  @@index([workspaceId, category])
  @@index([projectId])
  @@index([roomId])
  @@index([contractorId])
  @@map("documents")
}

model DocumentVersion {
  id          String     @id
  workspaceId String     @map("workspace_id")
  documentId  String     @map("document_id")
  document    Document   @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  /// 1, 2, 3...; never reused, even if a version is removed.
  number      Int
  fileId      String     @unique @map("file_id")
  file        FileObject @relation(fields: [fileId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  /// What changed ("Revised after the inspector's comments").
  note        String?
  createdById String?    @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@unique([documentId, number])
  @@unique([fileId, workspaceId])
  @@index([workspaceId])
  @@map("document_versions")
}
