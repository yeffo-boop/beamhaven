# Secrets: never commit real environment files
.env
.env.*
!.env.example
!.env.server.example
# The Google Cloud service account key for off-site backups
gcs-key.json

# Dependencies and build output
node_modules/
.next/
out/
dist/
coverage/
playwright-report/
test-results/

# Local data
/data/
/backups/
*.dump
*.sql.gz

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
*.log

# Next.js / TypeScript generated
next-env.d.ts
*.tsbuildinfo
.vercel
*.pem

# Prisma generated client (rebuilt by `npm install` / `npx prisma generate`)
/src/generated/

# Playwright login state saved by the end-to-end tests
/tests/e2e/.auth/
