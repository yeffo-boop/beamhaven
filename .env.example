# ---------------------------------------------------------------------------
# BeamHaven environment configuration (EXAMPLE, no real secrets here)
#
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
# `.env` is listed in .gitignore and must NEVER be committed to Git.
# On the server, `.env` lives next to docker-compose.yml and is readable
# only by the admin user (chmod 600 .env).
# ---------------------------------------------------------------------------

# --- Public address --------------------------------------------------------
# The full public URL people use to reach BeamHaven. No trailing slash.
# Read at RUNTIME on the server only. Changing it needs a restart, not a
# rebuild. See DOMAIN_MIGRATION.md.
#   Local development:   http://localhost:3000
#   Production:          https://beamhaven.thehoschak.com
APP_URL=http://localhost:3000

# Product name shown in the interface and emails (branding is not hardcoded).
APP_NAME=BeamHaven

# --- Runtime ---------------------------------------------------------------
# "development" on your Mac, "production" on the server.
NODE_ENV=development
# Port the app listens on inside its container.
PORT=3000

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# In Docker Compose the HOST is the service name "db", not localhost.
DATABASE_URL=postgresql://beamhaven:CHANGE_ME@localhost:5432/beamhaven?schema=public

# Used by docker-compose.yml to create the database on first start.
POSTGRES_USER=beamhaven
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=beamhaven

# --- Authentication (Better Auth) ------------------------------------------
# Long random secret (at least 32 characters) used to sign sessions and
# tokens. Generate one in Terminal with:
#     openssl rand -base64 32
# The app refuses to start while this still says CHANGE_ME.
# Changing it logs everyone out.
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# How long a login lasts, in days, before you must sign in again.
SESSION_MAX_AGE_DAYS=30

# --- Reverse proxy ---------------------------------------------------------
# Set to "true" only when running behind Nginx Proxy Manager, so the app
# trusts the X-Real-IP header it sends (used to rate-limit sign-in attempts
# per visitor).
TRUST_PROXY=false

# --- File uploads ----------------------------------------------------------
# Where uploaded files are stored inside the container (a Docker volume).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/uploads
# Largest allowed single upload, in megabytes. Nginx Proxy Manager's
# client_max_body_size must be at least this big. See DEPLOYMENT.md.
UPLOAD_MAX_MB=25

# --- Email (optional; added in a later milestone) --------------------------
# Leave blank until an email provider is chosen. Without it, invitation and
# password-reset links are shown to the household owner to send by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- AI (optional; Milestone 11, disabled by default) ----------------------
# AI features stay off until Jeff provides a key and approves the costs.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MONTHLY_BUDGET_USD=0
