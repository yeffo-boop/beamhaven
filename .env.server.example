# ---------------------------------------------------------------------------
# BeamHaven settings for the SERVER (example, no real secrets here)
#
# On the VM:   cp .env.server.example .env && chmod 600 .env && nano .env
# Never commit the real .env. Keep a copy of it in your password manager:
# without BETTER_AUTH_SECRET and POSTGRES_PASSWORD a backup can't be used.
# ---------------------------------------------------------------------------

# The public address people use. No trailing slash. Changing it only needs
# `docker compose up -d` (a restart), not a rebuild. See DOMAIN_MIGRATION.md.
APP_URL=https://beamhaven.thehoschak.com
APP_NAME=BeamHaven

# The VM's own LAN IP address. The website is published only on it, and the
# firewall lets only Nginx Proxy Manager connect.
APP_BIND_IP=<BEAMHAVEN_VM_IP>
APP_PORT=3000

# Database. Make the password with:  openssl rand -hex 24
# (letters and digits only, so it is safe inside the connection string).
POSTGRES_USER=beamhaven
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=beamhaven

# Signs logins. Make it with:  openssl rand -base64 32
# Changing it later signs everyone out.
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
SESSION_MAX_AGE_DAYS=30

# We're behind Nginx Proxy Manager, so trust the visitor address it sends.
TRUST_PROXY=true

# Uploads (used from Milestone 3). Nginx Proxy Manager's
# client_max_body_size must be at least this many megabytes.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/uploads
UPLOAD_MAX_MB=25
